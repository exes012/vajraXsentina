# ========================================================
# Sentinal Security Assessment Platform Configuration
# ========================================================

# Application Settings
PROJECT_NAME="Sentinal Security Assessment Platform"
ENVIRONMENT="production"
DEBUG=false
SECRET_KEY="replace-with-a-random-32-character-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default, or PostgreSQL)
DATABASE_URL="sqlite:///./sentinal.db"
# DATABASE_URL="postgresql://sentinal_user:password@localhost:5432/sentinal_db"

# AI Grounded Analysis Engine Settings
# Options: 'expert' (built-in zero-dependency engine), 'openai', 'anthropic', 'gemini', 'ollama'
AI_PROVIDER="expert"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_BASE_URL=""

# Scanner Orchestrator Limits
SCAN_TIMEOUT_SECONDS=300
MAX_CONCURRENT_SCANS=4
RETENTION_HOURS=24

# Optional GitHub Integration
GITHUB_DEFAULT_BRANCH="main"
